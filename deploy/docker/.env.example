# Compose-level settings. Copy to deploy/docker/.env (ignored by Git) and edit.
# Application settings live in apps/api/.env.production and apps/web/.env.production.

# Public https origin of the site: no path, no trailing slash. Compiled into the web bundle.
PUBLIC_ORIGIN=https://movies.example.com
# The same host without the scheme (Caddy requests the certificate for it).
DOMAIN=movies.example.com
# Contact address for the Let's Encrypt account.
ACME_EMAIL=admin@example.com

# Random database password. Use hex so it needs no URL-encoding: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME

# Runtime for every image. Keep this equal to engines.bun in package.json.
BUN_VERSION=1.4.3
# Image tag; set a release (for example the Git SHA) to keep older images for rollback.
TAG=latest
