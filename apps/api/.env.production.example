# Sample environment for PRODUCTION (API + media worker). Panduan: ../../docs/operations/deployment.md
#
#   Tanpa Docker : salin ke /etc/vertical-movie/api.env (chmod 640, owner root:vmovie)
#   Docker       : salin ke apps/api/.env.production (dibaca compose; DATABASE_URL dan API_INTERNAL_URL
#                  ditimpa oleh compose agar menunjuk ke service di jaringan Docker)
#
# Ganti SEMUA nilai bertanda CHANGE_ME. Jangan commit file hasil salinan; hanya sample ini yang dilacak.
# Daftar lengkap variabel dan statusnya: ../../docs/guides/environment.md

# --- Runtime -----------------------------------------------------------------
NODE_ENV=production
PORT=3001
# Alamat yang didengarkan. Tanpa Docker (di belakang reverse proxy di mesin yang sama): 127.0.0.1
# supaya API tidak terjangkau dari luar. Kosong = semua interface (Elysia/Bun). Docker: diatur compose (0.0.0.0).
HOST=127.0.0.1

# Production: info + JSON. LOG_HTTP_BODIES ditolak pada production.
LOG_LEVEL=info
LOG_FORMAT=json

# --- PostgreSQL --------------------------------------------------------------
# Satu database untuk data aplikasi, auth dan queue media. Gunakan password acak yang kuat.
# Sandi dengan karakter khusus harus di-URL-encode (mis. @ menjadi %40).
DATABASE_URL=postgresql://vmovie:CHANGE_ME@127.0.0.1:5432/vertical_movie_app

# --- Autentikasi (Better Auth) ----------------------------------------------
# Origin publik web (https, tanpa path). BETTER_AUTH_URL dan WEB_ORIGIN harus sama persis.
BETTER_AUTH_URL=https://movies.example.com
WEB_ORIGIN=https://movies.example.com
# Minimal 32 karakter acak: openssl rand -base64 48
# Mengganti secret ini mengakhiri semua sesi login yang ada.
BETTER_AUTH_SECRET=CHANGE_ME

# --- Media storage: Cloudflare R2 (wajib di production) ---------------------
# NODE_ENV=production menolak MinIO. Bucket harus privat (tanpa public access).
STORAGE_PROVIDER=r2
S3_ENDPOINT=https://CHANGE_ME_ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=CHANGE_ME_BUCKET
# API token R2 khusus bucket ini (Object Read & Write). Bukan root/global key.
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
# S3_SESSION_TOKEN=
# Browser mengunggah dan memutar langsung ke R2 lewat URL presigned: bucket perlu aturan CORS
# untuk origin web di atas (GET, PUT, HEAD; header ETag diekspos). Lihat panduan deploy.

# HLS dikirim melalui gateway web: kosong = WEB_ORIGIN + /api (harus origin web yang sama).
MEDIA_PLAYBACK_BASE_URL=

# Umur URL presigned (detik; 60-604800). Poster 24 jam; HLS = max(2 x durasi, nilai ini).
MEDIA_POSTER_URL_TTL_SECONDS=86400
MEDIA_HLS_URL_TTL_SECONDS=3600

# --- Upload multipart --------------------------------------------------------
MEDIA_UPLOAD_PART_CONCURRENCY=3
MEDIA_UPLOAD_SESSION_TTL_SECONDS=86400
MEDIA_UPLOAD_PART_URL_TTL_SECONDS=900

# --- Pemrosesan poster (di API) ----------------------------------------------
MEDIA_POSTER_MAX_PIXELS=16777216
MEDIA_POSTER_PROCESS_CONCURRENCY=1
MEDIA_POSTER_PROCESS_TIMEOUT_SECONDS=20

# --- Media worker (proses terpisah: worker:start / service worker) -----------
# FFmpeg dan FFprobe harus ada di mesin/image worker (Docker: sudah ada di image worker).
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Jumlah job video paralel per instance worker; naikkan hanya bila CPU/RAM cukup.
MEDIA_WORKER_CONCURRENCY=1
MEDIA_FFMPEG_THREADS=1
MEDIA_JOB_MAX_ATTEMPTS=3
MEDIA_JOB_RETRY_DELAYS_SECONDS=60,300
MEDIA_JOB_HEARTBEAT_SECONDS=15
MEDIA_JOB_LEASE_SECONDS=120
MEDIA_JOB_RECOVERY_POLL_SECONDS=30
MEDIA_TRANSCODE_TIMEOUT_FACTOR=3
MEDIA_TRANSCODE_MIN_TIMEOUT_SECONDS=900
MEDIA_JOB_STALL_TIMEOUT_SECONDS=300
MEDIA_JOB_POLL_SECONDS=5
MEDIA_JOB_HARD_TIMEOUT_SECONDS=7200
MEDIA_WORKER_SHUTDOWN_SECONDS=60
# Direktori kerja sementara (harus dapat ditulis dan berkapasitas besar).
MEDIA_WORKER_WORKDIR=/var/tmp/vertical-movie-worker
# Worker menolak job bila ruang kosong kurang dari ini (10 GiB).
MEDIA_WORKER_MIN_FREE_BYTES=10737418240
