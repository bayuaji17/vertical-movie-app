# Salin ke apps/api/.env. Panduan: ../../docs/guides/environment.md
# Runtime API.
PORT=3001

# PostgreSQL yang sama akan menyimpan data aplikasi, autentikasi, dan queue.
# Kredensial ini hanya contoh lokal, bukan kredensial production.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vertical_movie_app

# Test integrasi: database lokal khusus yang boleh di-reset oleh schema proof.
# Adapter proof hanya menerima vertical_movie_app_auth_test pada localhost.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vertical_movie_app_auth_test
AUTH_SCHEMA_TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vertical_movie_app_auth_schema_test
AUTH_RUNTIME_TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vertical_movie_app_auth_runtime_test
# Dedicated database for admin provisioning/recovery integration proofs; reset by tests.
AUTH_ADMIN_TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vertical_movie_app_auth_admin_test
# Metadata proofs reset public/drizzle; run schema and runtime suites serially.
CONTENT_TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vertical_movie_app_content_test
# Media proofs reset ONLY this dedicated local database.
MEDIA_TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vertical_movie_app_media_test

# Better Auth memakai origin web; browser akan melewati gateway web ke API.
# Isi secret acak sebelum menjalankan API. Jangan commit secret asli.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
WEB_ORIGIN=http://localhost:3000

# Media storage: API upload/delivery dan worker terpisah tersedia.
# Development: MinIO existing. Port 9000 adalah S3; 9001 hanya Console.
# Selector wajib ketika media diaktifkan: minio | r2, tanpa fallback otomatis.
STORAGE_PROVIDER=minio
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=vertical-movie-app
# Isi credential aplikasi khusus bucket ini; jangan memakai/commit root credential.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Opsional, hanya untuk kredensial sementara yang menggunakan session token.
S3_SESSION_TOKEN=

# Production: NODE_ENV=production, STORAGE_PROVIDER=r2,
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto,
# S3_BUCKET=<bucket-production>; isi credential R2 melalui env server.
# Mengganti env tidak memindahkan objek dari MinIO ke R2.

# Streaming HLS: kosong = WEB_ORIGIN + /api. Harus origin web yang sama.
MEDIA_PLAYBACK_BASE_URL=

# Native poster processing API settings; endpoint/runtime wiring is ACOV-005.
# Pixel cap includes the 1080x1920 output; concurrency is per API instance.
MEDIA_POSTER_MAX_PIXELS=16777216
MEDIA_POSTER_PROCESS_CONCURRENCY=1
# Logical deadline: response is fenced at this limit; Bun.Image terminals cannot be forcibly cancelled.
MEDIA_POSTER_PROCESS_TIMEOUT_SECONDS=20

# Worker media terpisah: bun run --cwd apps/api worker. Linux + GNU timeout.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Disetujui 4 Oktober 2026: konfigurasi env, default 1 job video per instance.
# Concurrency per instance; menjalankan API saja tidak menjalankan worker.
MEDIA_WORKER_CONCURRENCY=1

# Kebijakan worker aktif, divalidasi saat worker start.
# Attempts termasuk pertama; delay di sini untuk dua retry berikutnya.
MEDIA_JOB_MAX_ATTEMPTS=3
MEDIA_JOB_RETRY_DELAYS_SECONDS=60,300
MEDIA_JOB_HEARTBEAT_SECONDS=15
MEDIA_JOB_LEASE_SECONDS=120
MEDIA_JOB_RECOVERY_POLL_SECONDS=30
# Timeout encoding max(900 detik,3x durasi video aktual terverifikasi).
MEDIA_TRANSCODE_TIMEOUT_FACTOR=3
MEDIA_TRANSCODE_MIN_TIMEOUT_SECONDS=900
MEDIA_JOB_STALL_TIMEOUT_SECONDS=300
# Kandidat konservatif; benchmark mesin target tetap diperlukan.
MEDIA_JOB_POLL_SECONDS=5
MEDIA_JOB_HARD_TIMEOUT_SECONDS=7200
MEDIA_WORKER_SHUTDOWN_SECONDS=60
MEDIA_FFMPEG_THREADS=1
MEDIA_WORKER_WORKDIR=/var/tmp/vertical-movie-worker
MEDIA_WORKER_MIN_FREE_BYTES=10737418240

# Upload multipart: loader dan endpoint API tersedia; UI browser menyusul.
# Part concurrency per file, berbeda dari worker concurrency.
MEDIA_UPLOAD_PART_CONCURRENCY=3
MEDIA_UPLOAD_SESSION_TTL_SECONDS=86400
# TTL efektif URL part dibatasi sisa umur session.
MEDIA_UPLOAD_PART_URL_TTL_SECONDS=900

# Optional dedicated storage/browser proofs only; never production/app bucket cleanup.
# Credentials may create/delete fresh test buckets; leave blank outside proofs.
# MEDIA_STORAGE_TEST_ENDPOINT=http://localhost:9000
# MEDIA_STORAGE_TEST_ACCESS_KEY_ID=
# MEDIA_STORAGE_TEST_SECRET_ACCESS_KEY=
# MEDIA_PLAYBACK_BROWSER_PROOF=1
# MEDIA_PLAYBACK_BROWSER_RUNTIME=dev
# MEDIA_PLAYBACK_QUALITY_PROOF=1
# Optional full synthetic duration: 600 (episode) or 1800 (movie). Run serial.
# MEDIA_PLAYBACK_LONG_DURATION_SECONDS=600
# MEDIA_BROWSER_NODE=<absolute Node executable path>
# MEDIA_PLAYWRIGHT_MODULE=<absolute installed Playwright module path>
# MEDIA_BROWSER_EXECUTABLE=<absolute Chromium/Chrome executable path>
# MEDIA_BROWSER_WORKER_PATH=<absolute media-browser-worker.mjs path visible to Node>
# MEDIA_PLAYBACK_BROWSER_WORKER_PATH=<absolute media-playback-browser.mjs path visible to Node>
