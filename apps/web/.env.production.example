# Sample environment for PRODUCTION (web). Panduan: ../../docs/operations/deployment.md
#
#   Tanpa Docker : salin ke /etc/vertical-movie/web.env (chmod 640, owner root:vmovie)
#   Docker       : salin ke apps/web/.env.production (dibaca compose; API_INTERNAL_URL, HOST dan PORT
#                  ditimpa oleh compose)
#
# PENTING: VITE_API_URL juga masuk ke bundle browser saat BUILD. Setel nilai yang sama saat
# `bun run build` (atau build-arg Docker), jika tidak, login dan API dari browser tidak berfungsi.

NODE_ENV=production
PORT=3000
# Di belakang reverse proxy pada mesin yang sama: 127.0.0.1. Di dalam container: 0.0.0.0 (diatur compose).
HOST=127.0.0.1

# Origin publik web (https, tanpa path); sama dengan WEB_ORIGIN/BETTER_AUTH_URL pada API.
VITE_API_URL=https://movies.example.com

# Alamat API dari sisi server web (jaringan internal). Jangan diekspos ke internet.
API_INTERNAL_URL=http://127.0.0.1:3001

# Production: info + JSON.
LOG_LEVEL=info
LOG_FORMAT=json
