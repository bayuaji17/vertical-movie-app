{
  "name": "web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "bun run --bun vite dev",
    "generate-routes": "bun run --bun tsr generate",
    "build": "bun run --bun vite build",
    "start": "bun .output/server/index.mjs",
    "preview": "bun run --bun vite preview",
    "auth:gateway:proof": "bun test ./test/auth-gateway.test.ts",
    "auth:gateway:smoke": "bun ./test/auth-gateway-smoke.mjs",
    "lint": "bun run --bun eslint",
    "check-types": "bun run --bun tsc --noEmit",
    "format": "bun run --bun prettier --write . && bun run --bun eslint --fix",
    "check": "bun run --bun prettier --check ."
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@remixicon/react": "^4.9.0",
    "@repo/auth": "workspace:*",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-form": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-query-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@videojs/core": "10.0.0-rc.4",
    "@videojs/react": "10.0.0-rc.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "nitro": "3.0.260610-beta",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@tanstack/intent": "^0.4.0",
    "@tanstack/router-cli": "^1.132.0",
    "bun-types": "latest",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.20.0",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
