# Salin ke apps/web/.env. Panduan: ../../docs/ENVIRONMENT.md
# Vite dev server dan server production Nitro/Bun.
PORT=3000
HOST=127.0.0.1

# Publik: akan digunakan oleh client API dan Better Auth saat development.
# Nilai VITE_* masuk bundle browser saat build. Jangan isi dengan secret.
VITE_API_URL=http://localhost:3001
