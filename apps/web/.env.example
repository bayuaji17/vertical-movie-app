# Salin ke apps/web/.env. Panduan: ../../docs/guides/environment.md
# Vite dev server dan server production Nitro/Bun.
PORT=3000
HOST=127.0.0.1

# Origin publik web; client API/auth akan melewati gateway same-origin.
# Nilai VITE_* masuk bundle browser saat build. Jangan isi dengan secret.
VITE_API_URL=http://localhost:3000

# Hanya untuk server TanStack Start; jangan ganti dengan input pengguna.
API_INTERNAL_URL=http://localhost:3001

# Logging server web (paket @repo/log); LOG_HTTP_BODIES tidak dipakai web. Default: debug+pretty di development, info+json pada NODE_ENV=production.
# LOG_LEVEL=debug            # debug | info | warn | error
# LOG_FORMAT=pretty          # pretty | json
# LOG_HTTP_BODIES=false      # true mencatat body JSON request/response (terredaksi, 2 KB); ditolak pada production
