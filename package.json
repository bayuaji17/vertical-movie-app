{
  "name": "vertical-movie-app",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "db:studio": "bun run --cwd apps/api db:studio",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "format": "bun run --bun prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "lint:commit": "bun run --bun ./node_modules/.bin/commitlint",
    "prepare": "bun run --bun husky",
    "docs:check": "bun scripts/check-docs.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "husky": "^9.1.7",
    "prettier": "3.9.6",
    "turbo": "^2.11.5",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
